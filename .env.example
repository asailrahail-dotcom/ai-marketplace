# Copy to .env and fill in real values. Never commit .env.
# A Postgres connection string — e.g. from Vercel Postgres/Neon/Supabase,
# or a local Postgres instance. Prisma needs a real Postgres database; it
# will create the tables for you (via `npx prisma db push`).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Session signing secrets — generate long random strings for real deployments.
USER_JWT_SECRET="change-me-user-secret"
ADMIN_JWT_SECRET="change-me-admin-secret"

# Optional: enable real LLM-based needs extraction. When unset, the app
# falls back to the built-in rule-based Arabic extractor (no external call).
# ANTHROPIC_API_KEY=""

# Optional Saudi payment/verification providers. Never expose these to the
# client — they are read only on the server. Leave unset to keep checkout in
# manual/offline mode (order is created, marked pending payment confirmation).
# MOYASAR_SECRET_KEY=""
# AUTHENTICA_API_KEY=""
